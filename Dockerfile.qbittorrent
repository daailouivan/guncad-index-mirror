ARG qbittorrent_image=docker.io/qbittorrentofficial/qbittorrent-nox:5.2.3-1
FROM ${qbittorrent_image}

# Pull in Alpine security fixes (OpenSSL, expat, pcre2, util-linux, c-ares,
# python3, ...) that landed after the upstream image was published.
RUN apk upgrade --no-cache

COPY --chmod=755 contrib/qbittorrent-entrypoint.py /usr/local/bin/start-guncad-qbittorrent

ENTRYPOINT ["/sbin/tini", "-g", "--", "/usr/local/bin/start-guncad-qbittorrent"]
