+    @requires(BLOB_COMPONENT, DATABASE_COMPONENT, FILE_MANAGER_COMPONENT)
+    async def jsonrpc_stream_get(
+            self, sd_hash, file_name=None, download_directory=None, timeout=None, save_file=True):
+        """
+        Download a stream directly from its descriptor hash, without resolving a claim.
+
+        Usage:
+            stream_get <sd_hash> [<file_name> | --file_name=<file_name>]
+             [<download_directory> | --download_directory=<download_directory>]
+             [<timeout> | --timeout=<timeout>] [--save_file=<save_file>]
+
+        Options:
+            --sd_hash=<sd_hash>      : (str) stream descriptor hash to download
+            --file_name=<file_name>  : (str) optional output file name
+            --download_directory=<download_directory> : (str) output directory
+            --timeout=<timeout>      : (int) download timeout in seconds
+            --save_file=<save_file>  : (bool) save the decrypted stream to disk
+
+        Returns: {File}
+        """
+        if not is_valid_blobhash(sd_hash):
+            return {"error": "sd_hash must be a valid blob hash"}
+        if download_directory and not os.path.isdir(download_directory):
+            return {"error": f"specified download directory \"{download_directory}\" does not exist"}
+
+        timeout = timeout or self.conf.download_timeout
+        source_manager = self.file_manager.source_managers['stream']
+        existing = source_manager.get_filtered(sd_hash=sd_hash)
+        if len(existing) > 1:
+            return {"error": f"multiple local streams matched {sd_hash}"}
+
+        stream = existing[0] if existing else None
+        try:
+            if stream is None:
+                stream = ManagedStream(
+                    source_manager.loop, self.conf, source_manager.blob_manager, sd_hash,
+                    download_directory, file_name, ManagedStream.STATUS_STOPPED,
+                    analytics_manager=self.analytics_manager
+                )
+                stream.downloader.node = source_manager.node
+                await stream.start(timeout=timeout, save_now=save_file)
+                source_manager.add(stream)
+            elif stream.output_file_exists and stream.completed:
+                return stream
+            else:
+                stream.downloader.node = source_manager.node
+                await stream.start(timeout=timeout, save_now=save_file)
+
+            if save_file and not stream.output_file_exists:
+                await stream.start_saving(file_name, download_directory)
+        except Exception as e:
+            log.warning("Error downloading stream %s: %s", sd_hash, str(e))
+            return {"error": str(e)}
+        return stream
+
