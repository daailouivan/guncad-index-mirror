#
# Example default configuration for GunCAD Mirror
#
# This is a perfectly serviceable configuration for usage in production, if
# you just want to mirror the whole Index at guncadindex.com.
#
# See README.md for detailed configuration, if that's your jam.
#

# If you don't set this, you get wonky timezone configs
TZ="America/Chicago"

# This is the API endpoint to use for fetching releases. The default value
# is fine.
#MIRROR_API_ENDPOINT="https://guncadindex.com/api/releases/?format=json&limit=100"
MIRROR_API_ENDPOINT="https://thisdomaindoesntexist.foo/api/releases"

# WARNING: Turning this on doubles your disk space usage.
# See README for more info.
#MIRROR_ASSEMBLE_FILES="True"

# Turn this one on to enable the web UI for monitoring.
# Note that this uses the inefficient Flask debug web frontend
MIRROR_ENABLE_WEBUI="True"
