#
# Example default configuration for GunCAD Mirror
#
# This is a perfectly serviceable configuration for usage in production, if
# you just want to mirror the whole Index at guncadindex.com.
#
# See README.md for detailed configuration, if that's your jam.
#
MIRROR_API_ENDPOINT="https://guncadindex.com/api/releases"
MIRROR_DISK_USAGE_PERCENT="85"
