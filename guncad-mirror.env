# GunCAD Mirror example configuration
#
# Values are parsed by guncadmirror.settings. Invalid booleans, numbers, URLs,
# or tracker addresses stop startup instead of silently changing behavior.

TZ="America/Chicago"

# GunCAD Index API v2 only. Search and sort parameters are passed through, so
# this can point at any filtered releases query returned by the Index UI.
MIRROR_API_ENDPOINT="https://guncadindex.com/api/v2/releases/?format=json&limit=100"

# Bounds for one Index walk. A zero release cap means no per-cycle cap.
MIRROR_API_MAX_PAGES="1000"
MIRROR_MAX_RELEASES_PER_RUN="0"

# JSON-RPC endpoint for the lbrynet daemon packaged in the container.
MIRROR_LBRY_URL="http://127.0.0.1:5279"

# After LBRY peer acquisition fails, Odysee can supply plaintext only when its
# resolved claim ID, sd_hash, size, and SHA-384 all match the Index record.
MIRROR_ODYSEE_FALLBACK="True"
MIRROR_ODYSEE_PROXY_URL="https://api.na-backend.odysee.com/api/v1/proxy"

# Separate worker limits keep a slow CDN fallback from occupying an LBRY slot.
# Finalization covers plaintext verification and BitTorrent piece hashing.
MIRROR_LBRY_CONCURRENCY="4"
MIRROR_ODYSEE_CONCURRENCY="2"
MIRROR_FINALIZE_CONCURRENCY="2"

# Comma-separated channel-handle prefixes. Replace the claim delimiter colon
# with a hash sign so @author:a becomes @author#a.
# MIRROR_BLACKLISTED_HANDLES="@blocked#a,@another#b"

# A zero maximum disables the per-release size limit. Mirror also requires
# room for both encrypted blobs and plaintext, then preserves this reserve.
MIRROR_RELEASE_MAX_SIZE="10737418240"
MIRROR_MIN_FREE_SPACE="5368709120"

# Seconds between scans, LBRY startup deadline, maximum time without stream
# blob progress, and file completion polls.
MIRROR_LOOP_INTERVAL="14400"
MIRROR_CYCLE_ERROR_INTERVAL="60"
MIRROR_LBRY_STARTUP_TIMEOUT="300"
MIRROR_DOWNLOAD_TIMEOUT="3600"
MIRROR_DOWNLOAD_POLL_INTERVAL="2"

# HTTP/RPC retry count and initial exponential-backoff delay in seconds.
MIRROR_RETRY_ATTEMPTS="5"
MIRROR_RETRY_BACKOFF="2"

# Enable the local status page exposed by the Compose file on port 8081.
MIRROR_ENABLE_WEBUI="True"

# BitTorrent v1 piece length must be a power of two and at least 16 KiB.
MIRROR_TORRENT_PIECE_LENGTH="1048576"

# Optional operator-owned tracker hints for qBittorrent. Mirror's outbox and
# Index uploads stay trackerless. Index blacklisting overrides this list.
# MIRROR_TORRENT_TRACKERS="udp://tracker.example:6969/announce"

# Mirror derives the public tracker-policy endpoint as a sibling of
# MIRROR_PUBLISH_URL. Set an explicit URL when a reverse proxy uses a different
# route. The last valid response is cached in mirror-state.sqlite3.
# MIRROR_TRACKER_POLICY_URL="https://guncadindex.com/api/v2/torrents/tracker-policy/"
MIRROR_TRACKER_POLICY_TIMEOUT="15"

# Compose runs a private qBittorrent Web API beside Mirror. Set a high-entropy
# password before starting the production stack; its empty value is rejected.
# qBittorrent sees the data volume read-only at /downloads and seeds the
# assembled files without copying them.
MIRROR_QBITTORRENT_USERNAME="mirror"
MIRROR_QBITTORRENT_PASSWORD=""
MIRROR_QBITTORRENT_TIMEOUT="15"
MIRROR_QBITTORRENT_READY_TIMEOUT="120"
MIRROR_QBITTORRENT_POLL_INTERVAL="2"
MIRROR_QBITTORRENT_RECHECK_INTERVAL="300"
MIRROR_QBITTORRENT_CATEGORY="guncad-mirror"
MIRROR_QBITTORRENT_TAG="guncad-mirror"

# Authenticated publication is opt-in. It cannot run until qBittorrent has an
# active seed for the exact torrent. The token must be a high-entropy secret
# shared with GunCAD Index. Payload bytes stay on this node.
MIRROR_PUBLISH_ENABLED="False"
MIRROR_PUBLISH_URL="https://guncadindex.com/api/v2/torrents/publish/"
# MIRROR_PUBLISH_TOKEN="replace-with-a-high-entropy-secret"
MIRROR_PUBLISH_CONCURRENCY="2"
MIRROR_PUBLISH_TIMEOUT="60"
